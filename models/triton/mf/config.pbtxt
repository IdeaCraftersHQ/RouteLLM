name: "mf"
platform: "onnxruntime_onnx"

input [
  {
    name: "strong_id"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "weak_id"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [ 1536 ]
  }
]

output [
  {
    name: "win_rate"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
  }
]
