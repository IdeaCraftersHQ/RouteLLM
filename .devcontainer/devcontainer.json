{
  "name": "IdeaCraftersHQ/RouteLLM dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/prulloac/devcontainer-features/pre-commit:1": {},
    "ghcr.io/jungaretti/features/make:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
  },
  "forwardPorts": [6060],
  "portsAttributes": {
    "6060": {
      "label": "routellm server"
    }
  },
  "postCreateCommand": "uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -e \".[dev,serve]\" && pre-commit install && echo 'Dev environment ready. Run: PYTHONPATH=. python -m pytest routellm/tests -q'",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "GitHub.copilot"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": [
          "routellm/tests"
        ]
      }
    }
  },
  "remoteUser": "vscode"
}
