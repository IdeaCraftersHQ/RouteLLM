{"id": "location-04", "lang": "fr", "text": "Il a déménagé de Trois-Rivières vers Laval.", "spans": [{"start": 17, "end": 31, "category": "location", "text": "Trois-Rivières"}, {"start": 37, "end": 42, "category": "location", "text": "Laval"}]}
{"id": "location-05", "lang": "fr", "text": "Le sinistre est survenu à Saguenay en janvier.", "spans": [{"start": 26, "end": 34, "category": "location", "text": "Saguenay"}]}
